# ==============================================================
# 🇺🇸 TechJobs US — Environment Configuration
# ==============================================================

# Database (PostgreSQL - Recommended: Supabase / Neon in US-East or US-West)
DATABASE_URL="postgresql://postgres:password@localhost:5432/techjobs_us?schema=public"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
# Generate secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-secret-key-here"

# OAuth Providers (Tailored for US Tech & Engineering)
GITHUB_ID="your-github-oauth-client-id"
GITHUB_SECRET="your-github-oauth-client-secret"
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# File Uploads (PDF Resumes, Tech Certifications, Company Badges)
UPLOADTHING_SECRET="your-uploadthing-secret"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# Transactional Emails & US Job Alert Digests (Resend)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="TechJobs US <alerts@techjobsus.com>"
